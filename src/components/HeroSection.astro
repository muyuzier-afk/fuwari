---
import { Icon } from "astro-icon/components";
import { siteConfig } from "../config";
import { url } from "../utils/url-utils";

const hero = siteConfig.hero;

if (!hero?.enable) {
	throw new Error("HeroSection rendered without hero config");
}

const rotatingLines = hero.rotatingLines ?? [];
---

<section class="hero-card card-base relative overflow-hidden px-6 py-7 md:px-8 md:py-8">
	<div class="hero-card__glow"></div>
	<div class="hero-card__grid relative z-10 grid gap-6 lg:grid-cols-[minmax(0,1.6fr)_minmax(18rem,0.9fr)] lg:items-end">
		<div class="space-y-5">
			{hero.badge && (
				<div class="inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/45 px-3 py-1 text-[0.72rem] font-semibold uppercase tracking-[0.26em] text-black/60 backdrop-blur dark:bg-white/10 dark:text-white/60">
					<Icon name="material-symbols:auto-awesome-outline-rounded" class="text-sm text-[var(--primary)]" />
					{hero.badge}
				</div>
			)}
			<div class="space-y-3">
				<h1 class="max-w-4xl text-4xl font-bold leading-tight tracking-[-0.03em] text-black/90 dark:text-white/90 md:text-5xl lg:text-6xl">
					{hero.title}
				</h1>
				<p class="max-w-3xl text-sm leading-7 text-black/65 dark:text-white/65 md:text-base">
					{hero.description}
				</p>
			</div>
			{rotatingLines.length > 0 && (
				<div class="hero-rotator inline-flex min-h-[2.75rem] items-center gap-3 rounded-2xl border border-white/15 bg-black/5 px-4 py-3 text-sm text-black/60 backdrop-blur dark:bg-white/5 dark:text-white/60 md:text-[0.95rem]">
					<Icon name="fa6-solid:circle-dot" class="text-sm text-[var(--primary)]" />
					<span id="hero-rotating-line" data-lines={JSON.stringify(rotatingLines)}>{rotatingLines[0]}</span>
				</div>
			)}
			{hero.actions && hero.actions.length > 0 && (
				<div class="flex flex-wrap gap-3">
					{hero.actions.map((action) => {
						const href = action.external ? action.url : url(action.url);
						return (
							<a
								href={href}
								target={action.external ? "_blank" : undefined}
								rel={action.external ? "noreferrer noopener" : undefined}
								class:list={[
									"hero-action inline-flex h-11 items-center justify-center gap-2 rounded-xl px-4 text-sm font-semibold transition",
									action.style === "ghost"
										? "bg-black/5 text-black/75 hover:bg-black/10 dark:bg-white/5 dark:text-white/75 dark:hover:bg-white/10"
										: "bg-[var(--primary)] text-white shadow-lg hover:brightness-110",
								]}
							>
								<span>{action.label}</span>
								{action.external && <Icon name="fa6-solid:arrow-up-right-from-square" class="text-xs" />}
							</a>
						);
					})}
				</div>
			)}
		</div>
		{hero.stats && hero.stats.length > 0 && (
			<div class="grid gap-3 sm:grid-cols-3 lg:grid-cols-1">
				{hero.stats.map((item) => (
					<div class="hero-stat rounded-2xl border border-white/15 bg-white/55 px-4 py-4 backdrop-blur dark:bg-white/8">
						<div class="text-2xl font-bold tracking-[-0.04em] text-black/90 dark:text-white/90">{item.value}</div>
						<div class="mt-1 text-xs font-medium uppercase tracking-[0.2em] text-black/45 dark:text-white/45">{item.label}</div>
					</div>
				))}
			</div>
		)}
	</div>
</section>

<script is:inline>
	const initHeroRotator = () => {
		const node = document.getElementById("hero-rotating-line");
		if (!node) return;
		const lines = JSON.parse(node.dataset.lines || "[]");
		if (!Array.isArray(lines) || lines.length < 2) return;

		let index = 0;
		if (window.__moehansHeroRotator) {
			window.clearInterval(window.__moehansHeroRotator);
		}
		window.__moehansHeroRotator = window.setInterval(() => {
			index = (index + 1) % lines.length;
			node.classList.add("opacity-0", "translate-y-1");
			window.setTimeout(() => {
				node.textContent = lines[index];
				node.classList.remove("opacity-0", "translate-y-1");
			}, 180);
		}, 3600);
	};

	initHeroRotator();
	document.addEventListener("astro:after-swap", initHeroRotator);
</script>
