---
import { Icon } from "astro-icon/components";
import { siteConfig } from "../config";
import { getCategoryList } from "../utils/content-utils";
import { url } from "../utils/url-utils";

const allCategories = await getCategoryList();
const maxItems = siteConfig.postListLayout?.categoryBar.maxItems ?? allCategories.length;
const categories = allCategories.slice(0, maxItems);
---

<div class="category-bar card-base px-4 py-4 md:px-5">
	<div class="mb-3 flex items-center justify-between gap-4">
		<div>
			<div class="text-xs font-semibold uppercase tracking-[0.2em] text-black/45 dark:text-white/45">Browse</div>
			<div class="text-base font-semibold text-black/85 dark:text-white/85">按分类继续阅读</div>
		</div>
		<Icon name="material-symbols:widget-small-outline-rounded" class="text-2xl text-[var(--primary)]" />
	</div>
	<div class="flex flex-wrap gap-2">
		<a href={url("/archive/")} class="category-pill category-pill-active">
			<span>全部文章</span>
		</a>
		{categories.map((category) => (
			<a href={category.url} class="category-pill">
				<span>{category.name}</span>
				<span class="category-pill__count">{category.count}</span>
			</a>
		))}
	</div>
</div>
