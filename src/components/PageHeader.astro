---
interface Props {
	title: string;
	subtitle?: string;
	compact?: boolean;
}

const { title, subtitle, compact = false } = Astro.props;
---

<div class:list={["page-header card-base", compact ? "px-5 py-5" : "px-6 py-6 md:px-8 md:py-7"]}>
	<h1 class="text-2xl font-bold text-black/90 dark:text-white/90 md:text-3xl">{title}</h1>
	{subtitle && <p class="mt-2 text-sm leading-7 text-black/55 dark:text-white/55">{subtitle}</p>}
</div>
