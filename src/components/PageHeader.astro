---
import { Icon } from "astro-icon/components";

interface Props {
	title: string;
	subtitle?: string;
	eyebrow?: string;
	compact?: boolean;
}

const {
	title,
	subtitle,
	eyebrow = "Special Page",
	compact = false,
} = Astro.props;
---

<div class:list={["page-header card-base relative overflow-hidden", compact ? "px-6 py-6" : "px-6 py-8 md:px-9 md:py-9"]}>
	<div class="page-header-glow"></div>
	<div class="relative z-10 flex flex-col gap-4">
		<div class="inline-flex w-fit items-center gap-2 rounded-full border border-white/15 bg-white/50 px-3 py-1 text-xs font-semibold uppercase tracking-[0.24em] text-black/55 backdrop-blur dark:bg-white/10 dark:text-white/60">
			<Icon name="material-symbols:auto-awesome-outline-rounded" class="text-sm text-[var(--primary)]" />
			{eyebrow}
		</div>
		<div class="space-y-3">
			<h1 class="text-3xl font-bold tracking-tight text-black/90 dark:text-white/90 md:text-4xl">{title}</h1>
			{subtitle && <p class="max-w-3xl text-sm leading-7 text-black/60 dark:text-white/60 md:text-[0.96rem]">{subtitle}</p>}
		</div>
	</div>
</div>
