---
import { Icon } from "astro-icon/components";
import { navBarConfig, siteConfig } from "../config";
import { LinkPresets } from "../constants/link-presets";
import { LinkPreset, type NavBarLink } from "../types/config";
import { url } from "../utils/url-utils";
import Search from "./Search.svelte";
import DisplaySettings from "./widget/DisplaySettings.svelte";
import NavMenuPanel from "./widget/NavMenuPanel.astro";

const className = Astro.props.class;
const titleConfig = siteConfig.navbarTitle;

const resolveAsset = (value?: string) => {
	if (!value) return "";
	return value.startsWith("http") ? value : url(value);
};

const titleIcon = resolveAsset(titleConfig?.icon);
const titleLogo = resolveAsset(titleConfig?.logo);

const links: NavBarLink[] = navBarConfig.links.map(
	(item: NavBarLink | LinkPreset): NavBarLink => {
		if (typeof item === "number") return LinkPresets[item];
		return item;
	},
);
---
<div id="navbar" class="z-50 onload-animation">
	<div class="absolute left-0 right-0 -top-8 h-8 bg-[var(--card-bg)] transition"></div>
	<div class:list={[
		className,
		"card-base !overflow-visible !rounded-t-none !border-transparent !shadow-none max-w-[var(--page-width)] h-[4.5rem] mx-auto flex items-center justify-between px-4",
	]}>
		<a href={url("/")} class="btn-plain scale-animation rounded-lg h-[3.25rem] px-5 font-bold active:scale-95 shrink-0">
			<div class="flex flex-row items-center text-md text-[var(--primary)]">
				{titleConfig?.mode === "logo" && titleLogo ? (
					<img src={titleLogo} alt={titleConfig.text} class="h-8 w-auto object-contain" loading="lazy" />
				) : (
					<>
						{titleIcon ? (
							<img src={titleIcon} alt="" class="mb-1 mr-2 h-7 w-7 object-cover" loading="lazy" />
						) : (
							<Icon name="material-symbols:home-outline-rounded" class="mb-1 mr-2 text-[1.75rem]" />
						)}
						<span>{titleConfig?.text || siteConfig.title}</span>
					</>
				)}
			</div>
		</a>

		<div class="hidden md:flex">
			{links.map((l) => (
				<a aria-label={l.name} href={l.external ? l.url : url(l.url)} target={l.external ? "_blank" : null} class="btn-plain scale-animation rounded-lg h-11 font-bold px-5 active:scale-95">
					<div class="flex items-center">
						{l.name}
						{l.external && <Icon name="fa6-solid:arrow-up-right-from-square" class="ml-1 -translate-y-[1px] text-[0.875rem] text-black/[0.2] transition dark:text-white/[0.2]" />}
					</div>
				</a>
			))}
		</div>

		<div class="flex">
			<Search client:only="svelte"></Search>
			{!siteConfig.themeColor.fixed && (
				<button aria-label="Display Settings" class="btn-plain scale-animation rounded-lg h-11 w-11 active:scale-90" id="display-settings-switch">
					<Icon name="material-symbols:palette-outline" class="text-[1.25rem]" />
				</button>
			)}
			<button aria-label="Toggle Theme" class="relative btn-plain scale-animation rounded-lg h-11 w-11 active:scale-90" id="scheme-switch">
				<div id="scheme-light" class="absolute opacity-0">
					<Icon name="material-symbols:wb-sunny-outline-rounded" class="text-[1.25rem]" />
				</div>
				<div id="scheme-dark" class="absolute opacity-0">
					<Icon name="material-symbols:dark-mode-outline-rounded" class="text-[1.25rem]" />
				</div>
				<div id="scheme-auto" class="absolute opacity-0">
					<Icon name="material-symbols:radio-button-partial-outline" class="text-[1.25rem]" />
				</div>
			</button>
			<button aria-label="Menu" name="Nav Menu" class="btn-plain scale-animation rounded-lg w-11 h-11 active:scale-90 md:!hidden" id="nav-menu-switch">
				<Icon name="material-symbols:menu-rounded" class="text-[1.25rem]" />
			</button>
		</div>

		<NavMenuPanel links={links}></NavMenuPanel>
		<DisplaySettings client:only="svelte"></DisplaySettings>
	</div>
</div>

<script>
const schemeModes = ["light", "dark", "auto"];

function showSchemeIcon(mode: string) {
	const light = document.getElementById("scheme-light");
	const dark = document.getElementById("scheme-dark");
	const auto = document.getElementById("scheme-auto");
	if (!light || !dark || !auto) return;
	light.classList.toggle("opacity-0", mode !== "light");
	dark.classList.toggle("opacity-0", mode !== "dark");
	auto.classList.toggle("opacity-0", mode !== "auto");
}

function applyScheme(mode: string) {
	const resolvedMode = mode === "auto"
		? (window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light")
		: mode;

	if (resolvedMode === "dark") {
		document.documentElement.classList.add("dark");
	} else {
		document.documentElement.classList.remove("dark");
	}

	localStorage.setItem("theme", mode);
	showSchemeIcon(mode);
}

function loadButtonScript() {
	const schemeBtn = document.getElementById("scheme-switch");
	if (schemeBtn) {
		showSchemeIcon(localStorage.getItem("theme") || "dark");
		schemeBtn.onclick = function () {
			const current = localStorage.getItem("theme") || "dark";
			const index = schemeModes.indexOf(current);
			const next = schemeModes[(index + 1) % schemeModes.length];
			applyScheme(next);
		};
	}

	const settingBtn = document.getElementById("display-settings-switch");
	if (settingBtn) {
		settingBtn.onclick = function () {
			const settingPanel = document.getElementById("display-setting");
			if (settingPanel) settingPanel.classList.toggle("float-panel-closed");
		};
	}

	const menuBtn = document.getElementById("nav-menu-switch");
	if (menuBtn) {
		menuBtn.onclick = function () {
			const menuPanel = document.getElementById("nav-menu-panel");
			if (menuPanel) menuPanel.classList.toggle("float-panel-closed");
		};
	}
}

loadButtonScript();
document.addEventListener("astro:after-swap", loadButtonScript);
</script>

{import.meta.env.PROD && <script is:inline define:vars={{scriptUrl: url('/pagefind/pagefind.js')}}>
async function loadPagefind() {
    try {
        const response = await fetch(scriptUrl, { method: 'HEAD' });
        if (!response.ok) {
            throw new Error(`Pagefind script not found: ${response.status}`);
        }

        const pagefind = await import(scriptUrl);

        await pagefind.options({
            excerptLength: 20
        });

        window.pagefind = pagefind;

        document.dispatchEvent(new CustomEvent('pagefindready'));
    } catch (error) {
        console.error('Failed to load Pagefind:', error);
        window.pagefind = {
            search: () => Promise.resolve({ results: [] }),
            options: () => Promise.resolve(),
        };
        document.dispatchEvent(new CustomEvent('pagefindloaderror'));
    }
}

if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', loadPagefind);
} else {
    loadPagefind();
}
</script>}
