---
import { Icon } from "astro-icon/components";
import { navBarConfig, siteConfig } from "../config";
import { LinkPresets } from "../constants/link-presets";
import { LinkPreset, type NavBarLink } from "../types/config";
import { pathsEqual, url } from "../utils/url-utils";
import Search from "./Search.svelte";
import DisplaySettings from "./widget/DisplaySettings.svelte";
import NavMenuPanel from "./widget/NavMenuPanel.astro";

const className = Astro.props.class;
const isHomePage = pathsEqual(Astro.url.pathname, url("/"));
const titleConfig = siteConfig.navbarTitle;

const resolveAsset = (value?: string) => {
	if (!value) return "";
	return value.startsWith("http") ? value : url(value);
};

const titleIcon = resolveAsset(titleConfig?.icon);
const titleLogo = resolveAsset(titleConfig?.logo);

const links: NavBarLink[] = navBarConfig.links.map(
	(item: NavBarLink | LinkPreset): NavBarLink => {
		if (typeof item === "number") {
			return LinkPresets[item];
		}
		return item;
	},
);
---
<div id="navbar" class="z-50 onload-animation group" data-is-home={String(isHomePage)}>
    <div class="absolute h-8 left-0 right-0 -top-8 bg-[var(--card-bg)] transition"></div>
    <div class:list={[className, "navbar-shell !overflow-visible max-w-[var(--page-width)] h-[4.5rem] mx-auto flex items-center justify-between px-4"]}>
        <a href={url('/')} class="navbar-brand btn-plain scale-animation rounded-2xl h-[3.25rem] px-4 md:px-5 font-bold active:scale-95 shrink-0">
            <div class="flex flex-row items-center gap-3 text-md text-black/85 dark:text-white/85">
                {titleConfig?.mode === "logo" && titleLogo ? (
                    <img src={titleLogo} alt={titleConfig.text} class="h-10 w-auto object-contain" loading="lazy" />
                ) : (
                    <>
                        {titleIcon ? (
                            <img src={titleIcon} alt="" class="h-8 w-8 rounded-xl object-cover" loading="lazy" />
                        ) : (
                            <div class="flex h-8 w-8 items-center justify-center rounded-xl bg-[var(--btn-plain-bg-hover)] text-[var(--primary)]">
                                <Icon name="material-symbols:home-outline-rounded" class="text-[1.3rem]" />
                            </div>
                        )}
                        <div class="flex flex-col items-start leading-none">
                            <span class="text-sm font-semibold tracking-[0.18em] uppercase text-black/50 dark:text-white/45">Personal Site</span>
                            <span class="mt-1 text-[0.98rem] font-bold tracking-[0.02em]">{titleConfig?.text || siteConfig.title}</span>
                        </div>
                    </>
                )}
            </div>
        </a>

        <div class="hidden md:flex items-center gap-1">
            {links.map((l) => {
                return <a aria-label={l.name} href={l.external ? l.url : url(l.url)} target={l.external ? "_blank" : undefined}
                          class="btn-plain scale-animation rounded-xl h-11 font-semibold px-4 active:scale-95"
                >
                    <div class="flex items-center gap-1.5">
                        {l.name}
                        {l.external && <Icon name="fa6-solid:arrow-up-right-from-square" class="text-[0.75rem] transition text-black/[0.25] dark:text-white/[0.25]"></Icon>}
                    </div>
                </a>;
            })}
        </div>

        <div class="flex items-center gap-1">
            <Search client:only="svelte"></Search>
            {!siteConfig.themeColor.fixed && (
                <button aria-label="Display Settings" class="btn-plain scale-animation rounded-xl h-11 w-11 active:scale-90" id="display-settings-switch">
                    <Icon name="material-symbols:palette-outline" class="text-[1.25rem]"></Icon>
                </button>
            )}
            <button aria-label="Toggle Theme" class="relative btn-plain scale-animation rounded-xl h-11 w-11 active:scale-90" id="scheme-switch">
                <div id="scheme-light" class="absolute opacity-0">
                    <Icon name="material-symbols:wb-sunny-outline-rounded" class="text-[1.25rem]"></Icon>
                </div>
                <div id="scheme-dark" class="absolute opacity-0">
                    <Icon name="material-symbols:dark-mode-outline-rounded" class="text-[1.25rem]"></Icon>
                </div>
                <div id="scheme-auto" class="absolute opacity-0">
                    <Icon name="material-symbols:radio-button-partial-outline" class="text-[1.25rem]"></Icon>
                </div>
            </button>
            <button aria-label="Menu" name="Nav Menu" class="btn-plain scale-animation rounded-xl w-11 h-11 active:scale-90 md:!hidden" id="nav-menu-switch">
                <Icon name="material-symbols:menu-rounded" class="text-[1.25rem]"></Icon>
            </button>
        </div>

        <NavMenuPanel links={links}></NavMenuPanel>
        <DisplaySettings client:only="svelte"></DisplaySettings>
    </div>
</div>

<script>
let navbarScrollHandler: (() => void) | undefined;
const schemeModes = ["light", "dark", "auto"];

function showSchemeIcon(mode: string) {
    const light = document.getElementById("scheme-light");
    const dark = document.getElementById("scheme-dark");
    const auto = document.getElementById("scheme-auto");
    if (!light || !dark || !auto) return;
    light.classList.toggle("opacity-0", mode !== "light");
    dark.classList.toggle("opacity-0", mode !== "dark");
    auto.classList.toggle("opacity-0", mode !== "auto");
}

function applyScheme(mode: string) {
    const resolvedMode = mode === "auto"
        ? (window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light")
        : mode;

    if (resolvedMode === "dark") {
        document.documentElement.classList.add("dark");
    } else {
        document.documentElement.classList.remove("dark");
    }

    localStorage.setItem("theme", mode);
    showSchemeIcon(mode);
}

function initNavbarState() {
    const navbar = document.getElementById("navbar");
    if (!navbar) return;
    const isHome = navbar.dataset.isHome === "true";

    const update = () => {
        if (!isHome) {
            navbar.classList.add("scrolled");
            return;
        }
        if ((window.scrollY || document.documentElement.scrollTop || 0) > 40) {
            navbar.classList.add("scrolled");
        } else {
            navbar.classList.remove("scrolled");
        }
    };

    update();
    if (navbarScrollHandler) {
        window.removeEventListener("scroll", navbarScrollHandler);
    }
    navbarScrollHandler = update;
    window.addEventListener("scroll", navbarScrollHandler, { passive: true });
}

function loadButtonScript() {
    const schemeBtn = document.getElementById("scheme-switch");
    if (schemeBtn) {
        showSchemeIcon(localStorage.getItem("theme") || "dark");
        schemeBtn.onclick = function () {
            const current = localStorage.getItem("theme") || "dark";
            const index = schemeModes.indexOf(current);
            const next = schemeModes[(index + 1) % schemeModes.length];
            applyScheme(next);
        };
    }

    const settingBtn = document.getElementById("display-settings-switch");
    if (settingBtn) {
        settingBtn.onclick = function () {
            const settingPanel = document.getElementById("display-setting");
            if (settingPanel) {
                settingPanel.classList.toggle("float-panel-closed");
            }
        };
    }

    const menuBtn = document.getElementById("nav-menu-switch");
    if (menuBtn) {
        menuBtn.onclick = function () {
            const menuPanel = document.getElementById("nav-menu-panel");
            if (menuPanel) {
                menuPanel.classList.toggle("float-panel-closed");
            }
        };
    }
}

initNavbarState();
loadButtonScript();
document.addEventListener("astro:after-swap", () => {
    initNavbarState();
    loadButtonScript();
});
</script>

{import.meta.env.PROD && <script is:inline define:vars={{scriptUrl: url('/pagefind/pagefind.js')}}>
async function loadPagefind() {
    try {
        const response = await fetch(scriptUrl, { method: 'HEAD' });
        if (!response.ok) {
            throw new Error(`Pagefind script not found: ${response.status}`);
        }

        const pagefind = await import(scriptUrl);

        await pagefind.options({
            excerptLength: 20
        });

        window.pagefind = pagefind;

        document.dispatchEvent(new CustomEvent('pagefindready'));
        console.log('Pagefind loaded and initialized successfully, event dispatched.');
    } catch (error) {
        console.error('Failed to load Pagefind:', error);
        window.pagefind = {
            search: () => Promise.resolve({ results: [] }),
            options: () => Promise.resolve(),
        };
        document.dispatchEvent(new CustomEvent('pagefindloaderror'));
        console.log('Pagefind load error, event dispatched.');
    }
}

if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', loadPagefind);
} else {
    loadPagefind();
}
</script>}
