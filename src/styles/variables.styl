/* utils */
white(a)
  rgba(255, 255, 255, a)

black(a)
  rgba(0, 0, 0, a)

rainbow-light = linear-gradient(to right, oklch(0.80 0.10 0), oklch(0.80 0.10 30), oklch(0.80 0.10 60), oklch(0.80 0.10 90), oklch(0.80 0.10 120), oklch(0.80 0.10 150), oklch(0.80 0.10 180), oklch(0.80 0.10 210), oklch(0.80 0.10 240), oklch(0.80 0.10 270), oklch(0.80 0.10 300), oklch(0.80 0.10 330), oklch(0.80 0.10 360))
rainbow-dark = linear-gradient(to right, oklch(0.70 0.10 0), oklch(0.70 0.10 30), oklch(0.70 0.10 60), oklch(0.70 0.10 90), oklch(0.70 0.10 120), oklch(0.70 0.10 150), oklch(0.70 0.10 180), oklch(0.70 0.10 210), oklch(0.70 0.10 240), oklch(0.70 0.10 270), oklch(0.70 0.10 300), oklch(0.70 0.10 330), oklch(0.70 0.10 360))

:root
  --radius-large 0.5rem
  --radius-xl 0.75rem
  --content-delay 150ms
  --shadow-sm: 0 6px 18px rgba(0, 0, 0, 0.10)
  --shadow-lg: 0 12px 32px rgba(0, 0, 0, 0.14)
  --shadow-card-hover: 0 16px 40px rgba(0, 0, 0, 0.14)
  --card-border: rgba(0, 0, 0, 0.06)
  --surface-soft: rgba(255, 255, 255, 0.52)
  --surface-strong: rgba(255, 255, 255, 0.78)

:root.dark
  --shadow-sm: 0 8px 24px rgba(0, 0, 0, 0.12)
  --shadow-lg: 0 14px 36px rgba(0, 0, 0, 0.16)
  --shadow-card-hover: 0 18px 42px rgba(0, 0, 0, 0.18)
  --card-border: rgba(255, 255, 255, 0.12)
  --surface-soft: rgba(255, 255, 255, 0.7)
  --surface-strong: rgba(255, 255, 255, 0.85)

/* Force light mode with frosted glass and light blue */
:root
  --primary: oklch(0.7 0.12 200) /* 淡蓝色 */
  --page-bg: oklch(0.97 0.01 200) /* 极浅淡蓝色背景 */
  --card-bg: rgba(255, 255, 255, 0.75) /* 半透明白色 */
  --btn-content: oklch(0.7 0.12 200) /* 淡蓝色 */
  --btn-regular-bg: rgba(255, 255, 255, 0.5) /* 半透明白色 */
  --btn-regular-bg-hover: rgba(255, 255, 255, 0.7) /* 更不透明的白色 */
  --btn-regular-bg-active: rgba(255, 255, 255, 0.8) /* 几乎不透明的白色 */
  --btn-plain-bg-hover: rgba(255, 255, 255, 0.4) /* 半透明白色 */
  --btn-plain-bg-active: rgba(255, 255, 255, 0.6) /* 更不透明的白色 */
  --btn-card-bg-hover: rgba(255, 255, 255, 0.6) /* 半透明白色 */
  --btn-card-bg-active: rgba(255, 255, 255, 0.75) /* 更不透明的白色 */
  --enter-btn-bg: var(--btn-regular-bg)
  --enter-btn-bg-hover: var(--btn-regular-bg-hover)
  --enter-btn-bg-active: var(--btn-regular-bg-active)
  --deep-text: oklch(0.25 0.02 200) /* 深蓝色文本 */
  --title-active: oklch(0.6 0.12 200) /* 深蓝色 */
  --line-divider: rgba(120, 180, 255, 0.2) /* 淡蓝色分隔线 */
  --line-color: rgba(120, 180, 255, 0.3) /* 淡蓝色线条 */
  --meta-divider: rgba(120, 180, 255, 0.4) /* 淡蓝色分隔符 */
  --inline-code-bg: rgba(255, 255, 255, 0.6) /* 半透明白色 */
  --inline-code-color: var(--btn-content) /* 淡蓝色 */
  --selection-bg: rgba(120, 180, 255, 0.3) /* 淡蓝色选择背景 */
  --codeblock-selection: rgba(120, 180, 255, 0.3) /* 淡蓝色代码块选择背景 */
  --codeblock-bg: rgba(255, 255, 255, 0.8) /* 半透明白色 */
  --codeblock-topbar-bg: rgba(255, 255, 255, 0.9) /* 几乎不透明的白色 */
  --license-block-bg: var(--codeblock-bg)
  --link-underline: rgba(120, 180, 255, 0.5) /* 淡蓝色链接下划线 */
  --link-hover: rgba(120, 180, 255, 0.7) /* 更深的淡蓝色 */
  --link-active: rgba(100, 160, 255, 0.8) /* 更深的淡蓝色 */
  --float-panel-bg: rgba(255, 255, 255, 0.8) /* 半透明白色 */
  --scrollbar-bg-light: rgba(120, 180, 255, 0.4) /* 淡蓝色滚动条 */
  --scrollbar-bg-hover-light: rgba(120, 180, 255, 0.5) /* 更深的淡蓝色 */
  --scrollbar-bg-active-light: rgba(120, 180, 255, 0.6) /* 更深的淡蓝色 */
  --scrollbar-bg-dark: var(--scrollbar-bg-light) /* 使用相同的淡蓝色 */
  --scrollbar-bg-hover-dark: var(--scrollbar-bg-hover-light)
  --scrollbar-bg-active-dark: var(--scrollbar-bg-active-light)
  --scrollbar-bg: var(--scrollbar-bg-light)
  --scrollbar-bg-hover: var(--scrollbar-bg-hover-light)
  --scrollbar-bg-active: var(--scrollbar-bg-active-light)
  --color-selection-bar: linear-gradient(to right, oklch(0.7 0.12 180), oklch(0.7 0.12 210), oklch(0.7 0.12 240)) /* 蓝色渐变 */
  --display-light-icon: 1
  --display-dark-icon: 0
  --admonitions-color-tip: oklch(0.75 0.14 180)
  --admonitions-color-note: oklch(0.75 0.14 250)
  --admonitions-color-important: oklch(0.75 0.14 310)
  --admonitions-color-warning: oklch(0.75 0.14 60)
  --admonitions-color-caution: oklch(0.65 0.2 25)
  --toc-badge-bg: var(--btn-regular-bg)
  --toc-btn-hover: oklch(0.22 0.02 var(--hue))
  --toc-btn-active: oklch(0.25 0.02 var(--hue))
  --toc-width: calc((100vw - var(--page-width)) / 2 - 1rem)
  --toc-item-active: oklch(0.35 0.07 var(--hue))

:root.dark
  --primary: oklch(0.7 0.12 200) /* 淡蓝色 */
  --page-bg: oklch(0.17 0.02 240) /* 深蓝色背景 */
  --card-bg: rgba(15, 23, 42, 0.75) /* 半透明黑色 */
  --btn-content: oklch(0.7 0.12 200) /* 淡蓝色 */
  --btn-regular-bg: rgba(15, 23, 42, 0.5) /* 半透明黑色 */
  --btn-regular-bg-hover: rgba(15, 23, 42, 0.7) /* 更不透明的黑色 */
  --btn-regular-bg-active: rgba(15, 23, 42, 0.8) /* 几乎不透明的黑色 */
  --btn-plain-bg-hover: rgba(15, 23, 42, 0.4) /* 半透明黑色 */
  --btn-plain-bg-active: rgba(15, 23, 42, 0.6) /* 更不透明的黑色 */
  --btn-card-bg-hover: rgba(15, 23, 42, 0.6) /* 半透明黑色 */
  --btn-card-bg-active: rgba(15, 23, 42, 0.75) /* 更不透明的黑色 */
  --enter-btn-bg: var(--btn-regular-bg)
  --enter-btn-bg-hover: var(--btn-regular-bg-hover)
  --enter-btn-bg-active: var(--btn-regular-bg-active)
  --deep-text: oklch(0.9 0.02 200) /* 浅蓝色文本 */
  --title-active: oklch(0.7 0.12 200) /* 淡蓝色 */
  --line-divider: rgba(120, 180, 255, 0.2) /* 淡蓝色分隔线 */
  --line-color: rgba(120, 180, 255, 0.3) /* 淡蓝色线条 */
  --meta-divider: rgba(120, 180, 255, 0.4) /* 淡蓝色分隔符 */
  --inline-code-bg: rgba(15, 23, 42, 0.6) /* 半透明黑色 */
  --inline-code-color: var(--btn-content) /* 淡蓝色 */
  --selection-bg: rgba(120, 180, 255, 0.3) /* 淡蓝色选择背景 */
  --codeblock-selection: rgba(120, 180, 255, 0.3) /* 淡蓝色代码块选择背景 */
  --codeblock-bg: rgba(15, 23, 42, 0.8) /* 半透明黑色 */
  --codeblock-topbar-bg: rgba(15, 23, 42, 0.9) /* 几乎不透明的黑色 */
  --license-block-bg: var(--codeblock-bg)
  --link-underline: rgba(120, 180, 255, 0.5) /* 淡蓝色链接下划线 */
  --link-hover: rgba(120, 180, 255, 0.7) /* 更深的淡蓝色 */
  --link-active: rgba(100, 160, 255, 0.8) /* 更深的淡蓝色 */
  --float-panel-bg: rgba(15, 23, 42, 0.8) /* 半透明黑色 */
  --scrollbar-bg-light: rgba(120, 180, 255, 0.4) /* 淡蓝色滚动条 */
  --scrollbar-bg-hover-light: rgba(120, 180, 255, 0.5) /* 更深的淡蓝色 */
  --scrollbar-bg-active-light: rgba(120, 180, 255, 0.6) /* 更深的淡蓝色 */
  --scrollbar-bg-dark: var(--scrollbar-bg-light) /* 使用相同的淡蓝色 */
  --scrollbar-bg-hover-dark: var(--scrollbar-bg-hover-light)
  --scrollbar-bg-active-dark: var(--scrollbar-bg-active-light)
  --scrollbar-bg: var(--scrollbar-bg-dark)
  --scrollbar-bg-hover: var(--scrollbar-bg-hover-dark)
  --scrollbar-bg-active: var(--scrollbar-bg-active-dark)
  --color-selection-bar: linear-gradient(to right, oklch(0.7 0.12 180), oklch(0.7 0.12 210), oklch(0.7 0.12 240)) /* 蓝色渐变 */
  --display-light-icon: 0
  --display-dark-icon: 1
  --admonitions-color-tip: oklch(0.75 0.14 180)
  --admonitions-color-note: oklch(0.75 0.14 250)
  --admonitions-color-important: oklch(0.75 0.14 310)
  --admonitions-color-warning: oklch(0.75 0.14 60)
  --admonitions-color-caution: oklch(0.65 0.2 25)
  --toc-badge-bg: var(--btn-regular-bg)
  --toc-btn-hover: oklch(0.9 0.02 var(--hue))
  --toc-btn-active: oklch(0.95 0.02 var(--hue))
  --toc-width: calc((100vw - var(--page-width)) / 2 - 1rem)
  --toc-item-active: oklch(0.85 0.07 var(--hue))
